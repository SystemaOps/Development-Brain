{
  "llm": {
    "base_url": "http://host.docker.internal:8080/v1",
    "model": "local-coding-model",
    "timeout_seconds": 180,
    "context_window": 29696
  },
  "flow_runtime": {
    "lease_seconds": 300,
    "heartbeat_seconds": 60,
    "worker_poll_seconds": 2,
    "recovery_enabled": true,
    "max_recovery_attempts": 3
  },
  "agents": {
    "planning": {
      "agent_type": "planning",
      "enabled": true,
      "implementation": "default",
      "checkpoint_namespace": "planning",
      "approval_required": true,
      "settings": {
        "require_plan_validation": true,
        "allow_legacy_planning_service": true
      }
    },
    "coding": {
      "agent_type": "coding",
      "enabled": true,
      "implementation": "default",
      "checkpoint_namespace": "coding",
      "approval_required": false,
      "settings": {
        "workspace_strategy": "isolated",
        "allowed_statuses": ["approved"]
      }
    },
    "verification": {
      "agent_type": "verification",
      "enabled": true,
      "implementation": "default",
      "checkpoint_namespace": "verification",
      "approval_required": false,
      "settings": {
        "independent_workspace": true,
        "require_diff_for_pass": true,
        "require_test_command_for_pass": false,
        "require_test_evidence_for_source_changes": false,
        "security_review_enabled": true,
        "openproject_projection_enabled": true,
        "openproject_verified_status_name": "Verified",
        "openproject_changes_required_status_name": "Changes required",
        "openproject_blocked_status_name": "Blocked",
        "openproject_override_status_name": "Done",
        "human_override_enabled": false,
        "human_override_allowed_verdicts": ["changes_requested"],
        "warn_on_sensitive_changes": false,
        "warn_on_missing_rollback": false,
        "large_change_line_threshold": 500,
        "large_change_file_threshold": 20
      }
    },
    "security_review": {
      "agent_type": "security_review",
      "enabled": false,
      "implementation": "default",
      "checkpoint_namespace": "security_review",
      "approval_required": false,
      "settings": {
        "severity_gate": "medium"
      }
    }
  }
}
