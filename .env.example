# Ada Development Brain — minimal .env example
# ---------------------------------
# Copy this file to .env and adjust values for your local environment.
# The project tolerates missing variables (pydantic extra="ignore"),
# so you can start with just the core settings and add integrations later.
# ---------------------------------

# --- Core (required) ---
BRAIN_API_KEYS=human:admin
POSTGRES_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/brain

# --- Optional data stores (defaults if omitted) ---
NEO4J_URI=bolt://localhost:7687
WEAVIATE_HOST=localhost
REDIS_URL=redis://localhost:6379/0

# --- Documentation / source-control integrations ---
# Uncomment and set values for the integrations you want to enable.

# XWiki (Phase 35)
# BRAIN_DOC_XWIKI_ENABLED=True
# BRAIN_DOC_XWIKI_URL=http://localhost:8080
# BRAIN_DOC_XWIKI_SECRET=xwiki-hook-secret

# Backstage (Phase 36)
# BRAIN_DOC_BACKSTAGE_ENABLED=True
# BRAIN_DOC_BACKSTAGE_URL=http://localhost:8080
# BRAIN_DOC_BACKSTAGE_API_KEY=sk-backstage

# GitLab (Phase 38)
# BRAIN_DOC_GITLAB_ENABLED=True
# BRAIN_DOC_GITLAB_URL=http://localhost:8081
# BRAIN_DOC_GITLAB_API_KEY=gl-api-key

# OpenProject (Phase 34)
# BRAIN_DOC_OPENPROJECT_ENABLED=True
# BRAIN_DOC_OPENPROJECT_URL=http://localhost:8082
# BRAIN_DOC_OPENPROJECT_API_KEY=op-key

# --- Security / webhooks ---
# Webhook secret used by OpenProject HMAC validation (Phase 34)
# BRAIN_SECURITY_WEBHOOK_OPENPROJECT_SECRET=op-secret

# --- Verification / policy ---
#BRAIN_VERIFICATION_REQUIRE_PASS_BEFORE_PR=True

# --- Rate limiting (optional overrides) ---
#BRAIN_RATELIMIT_ANALYSIS_TPS=10
#BRAIN_RATELIMIT_EXECUTION_TPS=5

# --- Misc ---
# Environment name (shown in /metrics)
#BRAIN_ENV=development