# Ada Development Brain — environment configuration reference
# -----------------------------------------------------------
# Copy this file to `.env` and adjust values for your environment.
#
# `BrainSettings` loads `.env` from the process working directory. Boolean values
# accept true/false, 1/0, and yes/no. Never commit real API keys, passwords, or
# webhook secrets.
#
# URLs below use localhost for processes started directly on the host. Docker
# Compose injects service names such as postgres, neo4j, weaviate, and redis.
# -----------------------------------------------------------

# =============================================================================
# Runtime identity
# =============================================================================

# Environment name shown by system status and the CLI. Default: development.
BRAIN_ENVIRONMENT=development

# Optional build/commit identifier returned by the version endpoint.
# BRAIN_BUILD_SHA=0123456789abcdef


# =============================================================================
# Brain API server
# =============================================================================

# Address and port used by the `brain-api` Uvicorn runner.
BRAIN_API_HOST=127.0.0.1
BRAIN_API_PORT=8000

# Uvicorn logging level and process count.
BRAIN_API_LOG_LEVEL=info
BRAIN_API_WORKERS=1


# =============================================================================
# PostgreSQL — canonical transactional state (required)
# =============================================================================

# Async SQLAlchemy URL. This is also used by Alembic migrations.
BRAIN_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/brain

# Log generated SQL. Keep false outside database debugging sessions.
BRAIN_DATABASE_ECHO=false

# SQLAlchemy connection-pool sizing.
BRAIN_DATABASE_POOL_SIZE=5
BRAIN_DATABASE_MAX_OVERFLOW=10
BRAIN_DATABASE_POOL_PRE_PING=true


# =============================================================================
# Neo4j — knowledge graph (optional; empty URI selects in-memory fallback)
# =============================================================================

BRAIN_NEO4J_URI=bolt://localhost:7687
BRAIN_NEO4J_USER=neo4j
BRAIN_NEO4J_PASSWORD=password
BRAIN_NEO4J_DATABASE=neo4j


# =============================================================================
# Weaviate — semantic index (optional; empty host selects in-memory fallback)
# =============================================================================

BRAIN_WEAVIATE_HOST=localhost
BRAIN_WEAVIATE_PORT=8080
BRAIN_WEAVIATE_GRPC_PORT=50051
BRAIN_WEAVIATE_SCHEME=http
BRAIN_WEAVIATE_CLASS_NAME=SemanticRecord


# =============================================================================
# Redis — API-to-worker command queue
# =============================================================================

# Use `redis` when API and worker are separate processes. `inmemory` is suitable
# only when producer and consumer share one Python process.
BRAIN_REDIS_PROVIDER=redis
BRAIN_REDIS_URL=redis://localhost:6379/0
BRAIN_REDIS_QUEUE_NAME=brain:commands


# =============================================================================
# Artifact storage
# =============================================================================

# Declared artifact-store settings. The current composition root still uses an
# in-memory artifact store; MinIO from compose.yaml is not wired to these fields.
BRAIN_ARTIFACTS_PROVIDER=local
BRAIN_ARTIFACTS_BASE_DIR=.brain/artifacts


# =============================================================================
# API authentication and webhook authentication
# =============================================================================

# Seed API keys at startup. Format:
#   name=role:plaintext[;name=role:plaintext...]
# Valid roles: human, service, webhook, executor, admin.
# Only SHA-256 hashes are retained in memory.
BRAIN_API_KEYS=local-admin=admin:change-me

# These flags are declared in settings. Global API authentication and general
# route-level rate limiting are not yet wired; metrics routes still require an
# admin API key regardless of BRAIN_AUTH_ENABLED.
BRAIN_AUTH_ENABLED=false
BRAIN_RATE_LIMIT_ENABLED=false

# Shared HMAC secret for POST /api/v1/webhooks/openproject.
# Expected header: X-OpenProject-Signature: sha256=<hex-hmac-of-raw-body>
# BRAIN_WEBHOOK_OPENPROJECT_SECRET=replace-with-a-random-secret

# Shared token for POST /api/v1/webhooks/gitlab.
# Expected header: X-Gitlab-Token: <token>
# BRAIN_WEBHOOK_GITLAB_TOKEN=replace-with-a-random-token


# =============================================================================
# OpenProject — work management and observation comments
# =============================================================================

# Intended standalone Brain settings.
# IMPORTANT: WorkManagementSettings currently lacks its BRAIN_WORK_MANAGEMENT_
# prefix, so these variables are not loaded by BrainSettings until that settings
# wiring is corrected. Tests currently configure WorkManagementSettings directly.
# BRAIN_WORK_MANAGEMENT_ENABLED=true
# BRAIN_WORK_MANAGEMENT_PROVIDER=openproject
# BRAIN_WORK_MANAGEMENT_REQUIRED=false
# BRAIN_WORK_MANAGEMENT_BASE_URL=http://localhost:8081
# BRAIN_WORK_MANAGEMENT_API_KEY=replace-with-openproject-api-key
# BRAIN_WORK_MANAGEMENT_PROJECT_ID=replace-with-brain-project-uuid
# BRAIN_WORK_MANAGEMENT_BRAIN_ACTOR_ID=replace-with-openproject-user-id

# compose.openproject.yaml reads these host-side values and forwards them as the
# BRAIN_WORK_MANAGEMENT_* variables above. They do not replace the separate
# BRAIN_WEBHOOK_OPENPROJECT_SECRET used to authenticate incoming webhooks.
# OPENPROJECT_API_KEY=replace-with-openproject-api-key
# OPENPROJECT_PROJECT_ID=replace-with-brain-project-uuid
# OPENPROJECT_BRAIN_ACTOR_ID=replace-with-openproject-user-id


# =============================================================================
# Documentation providers
# =============================================================================

# Git/Markdown documentation source. The adapter exists, but runtime source
# control construction is not wired yet, so enabling this only reports capability.
BRAIN_DOCUMENTATION_GIT_ENABLED=true
BRAIN_DOCUMENTATION_GIT_ROOT=.

# XWiki REST source. The current composition passes only the URL and therefore
# accesses pages anonymously. XWikiHTTPTransport supports Basic auth, but username
# and password fields are not yet exposed by BrainSettings.
# BRAIN_DOCUMENTATION_XWIKI_ENABLED=true
# BRAIN_DOCUMENTATION_XWIKI_URL=http://localhost:8082
# BRAIN_DOCUMENTATION_XWIKI_REQUIRED=false

# There is currently no XWiki webhook endpoint. XWiki change polling is defined by
# the adapter but is not yet executed by the scheduler.


# =============================================================================
# Docling Serve — PDF/DOCX/PPTX conversion
# =============================================================================

# Native Markdown, OpenAPI, YAML, JSON, and source files bypass Docling.
# IMPORTANT: DocumentConversionSettings currently lacks its intended environment
# prefix, so these compose/documented variables are not loaded until corrected.
# BRAIN_DOC_CONVERSION_ENABLED=true
# BRAIN_DOC_CONVERSION_PROVIDER=docling_serve
# BRAIN_DOC_CONVERSION_REQUIRED=false
# BRAIN_DOC_CONVERSION_BASE_URL=http://localhost:5001


# =============================================================================
# Backstage — optional declared software catalog
# =============================================================================

# `derived` keeps repository-discovered topology as the default. Use `backstage`
# to read declared catalog entities and reconcile them with discovered topology.
# IMPORTANT: SoftwareCatalogSettings currently lacks its intended environment
# prefix, so these variables are not loaded until settings wiring is corrected.
# BRAIN_SOFTWARE_CATALOG_ENABLED=true
# BRAIN_SOFTWARE_CATALOG_PROVIDER=derived
# BRAIN_SOFTWARE_CATALOG_REQUIRED=false
# BRAIN_SOFTWARE_CATALOG_EXTERNAL_TYPE=backstage
# BRAIN_SOFTWARE_CATALOG_EXTERNAL_ENABLED=false
# BRAIN_SOFTWARE_CATALOG_EXTERNAL_URL=http://localhost:7007

# The current Backstage HTTP transport has no API-key/Bearer-token setting and is
# suitable only for a catalog endpoint that permits anonymous access.


# =============================================================================
# Source control and isolated workspaces
# =============================================================================

# The LocalGitAdapter exists and requires `git` on PATH. The current composition
# root returns no SourceControlPort, so these intended variables are not operational
# and SourceControlSettings also lacks its intended environment prefix.
# BRAIN_SOURCE_CONTROL_ENABLED=true
# BRAIN_SOURCE_CONTROL_PROVIDER=local
# BRAIN_SOURCE_CONTROL_REQUIRED=false


# =============================================================================
# Coding executor — fake executor or Pi service
# =============================================================================

# `fake` is the safe default. Set `pi` to use the Pi ExecutorPort adapter.
BRAIN_EXECUTOR_CODING_PROVIDER=fake

# Pi HTTP service base URL. It must expose POST <URL>/execute.
# When provider=pi and this URL is empty, the current adapter returns a placeholder
# result rather than launching a real Pi subprocess.
# BRAIN_EXECUTOR_PI_URL=http://localhost:9002

# Optional Bearer token sent to the Pi service.
# BRAIN_EXECUTOR_PI_API_KEY=replace-with-pi-service-key


# =============================================================================
# Verification and automation policy
# =============================================================================

# Declared verification settings. Pull-request creation currently enforces a PASS
# verdict directly; timeout configuration is not yet passed to the command runner.
BRAIN_VERIFICATION_REQUIRE_PASS_BEFORE_PR=true
BRAIN_VERIFICATION_TIMEOUT_SECONDS=300

# Only AUTO_CREATE_PR is currently consumed by runtime orchestration/provider
# construction. The assignment and retry flags are declared but not yet enforced.
BRAIN_AUTOMATION_RUN_ON_ASSIGNMENT=true
BRAIN_AUTOMATION_AUTO_RETRY_VERIFICATION_FAILURE=true
BRAIN_AUTOMATION_AUTO_CREATE_PR=false


# =============================================================================
# GitLab — merge request provider
# =============================================================================

# Use `gitlab` to create merge requests after verification passes. `fake` creates
# deterministic local PR references when auto-create is enabled.
BRAIN_PULL_REQUEST_PROVIDER=fake
# BRAIN_PULL_REQUEST_GITLAB_URL=http://localhost:8929
# BRAIN_PULL_REQUEST_GITLAB_API_KEY=replace-with-gitlab-access-token

# Optional GitLab numeric project ID or URL-encoded path such as group/project.
# If omitted, the adapter derives it from Repository.external_refs or clone_url.
# BRAIN_PULL_REQUEST_GITLAB_PROJECT=group/project

# To receive merge events, also configure BRAIN_WEBHOOK_GITLAB_TOKEN above and
# point GitLab at POST /api/v1/webhooks/gitlab.


# =============================================================================
# Human approval policy
# =============================================================================

# These policy fields are declared but are not currently connected to the runtime
# approval workflow.
BRAIN_APPROVAL_ARCHITECTURE_CHANGES=true
BRAIN_APPROVAL_DATABASE_MIGRATIONS=true
BRAIN_APPROVAL_SECURITY_SENSITIVE_CHANGES=true
BRAIN_APPROVAL_NORMAL_CODE_CHANGES=false


# =============================================================================
# Scheduler
# =============================================================================

# compose.yaml currently sets BRAIN_SCHEDULER_INTERVAL=60, but scheduler/main.py
# does not read it and always uses the 60-second function default.
# BRAIN_SCHEDULER_INTERVAL=60


# =============================================================================
# Development and test-only overrides
# =============================================================================

# Integration-test databases. These databases must already exist.
# BRAIN_TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/brain_test
# BRAIN_MIGRATION_TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/brain_migration_test

# Image inspected by the Phase 32 Docker packaging test.
# BRAIN_IMAGE=brain:latest

# Clean virtual environment path used by the Phase 31 packaging test.
# BRAIN_CLEAN_VENV=.brain/test-venvs/brain-clean-venv


# =============================================================================
# Services present in compose.yaml but not configurable through BrainSettings
# =============================================================================

# PostgreSQL container variables (POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB),
# Neo4j NEO4J_AUTH, XWiki/MariaDB credentials, GitLab root credentials, and MinIO
# root credentials are currently hard-coded in the Compose files. Change those
# Compose values or use deployment secrets for any non-development environment.